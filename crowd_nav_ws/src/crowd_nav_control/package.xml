<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypeins="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>crowd_nav_control</name>
  <version>0.1.0</version>
  <description>
    ros2_control configuration for the Nvis 3302ARD digital twin: the hardware-interface
    swap point (sim today, ESP32 later) and the diff_drive_controller parameters.
  </description>
  <maintainer email="ashwinder4377@gmail.com">ashwinder</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>controller_manager</exec_depend>
  <exec_depend>diff_drive_controller</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>gz_ros2_control</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
