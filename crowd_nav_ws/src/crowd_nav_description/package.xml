<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypeins="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>crowd_nav_description</name>
  <version>0.1.0</version>
  <description>
    URDF/xacro digital twin of the Nvis 3302ARD RoboCar. Confirmed geometry from the
    manufacturer datasheet; unmeasured parameters are marked [PENDING] and listed in
    MEASUREMENTS.md.
  </description>
  <maintainer email="ashwinder4377@gmail.com">ashwinder</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher_gui</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
