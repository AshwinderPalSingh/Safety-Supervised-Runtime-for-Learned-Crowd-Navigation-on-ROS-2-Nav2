<?xml version="1.0"?>
<robot name="nvis_3302ard" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:include filename="$(find crowd_nav_description)/urdf/lidar.xacro"/>
  <xacro:include filename="$(find crowd_nav_control)/urdf/nvis_3302ard.ros2_control.xacro"/>

  <!-- ================= Physical properties ================= -->
  <!-- CONFIRMED from Nvis 3302ARD datasheet -->
  <xacro:property name="chassis_length" value="0.190"/>
  <xacro:property name="chassis_width"  value="0.190"/>
  <xacro:property name="chassis_height" value="0.080"/>
  <xacro:property name="total_mass"     value="1.0"/>

  <!-- Single source of truth for any circular collision-radius approximation of this robot
       (Nav2 costmaps, the Phase 9 safety supervisor's forward-sim collision check - see
       IMPLEMENTATION_PLAN.md S4.3). MUST be derived from the chassis DIAGONAL
       (sqrt((L/2)^2+(W/2)^2) = 0.1344 m), not the smaller face-normal half-width (0.095 m) -
       a real bug found in Phase 2 (docs/phase2-findings.md): an under-sized circular radius
       lets a planner think a squeeze is clear when the real square corners would clip.
       0.14 m adds a small margin over the exact 0.1344 m diagonal. Every consumer of a
       circular robot radius should reference this value, not re-derive or hardcode its own -
       crowd_nav_bringup/config/nav2_params.yaml's robot_radius already matches this; Phase 9
       must too. -->
  <xacro:property name="robot_collision_radius" value="0.14"/>

  <!-- [PENDING] ESTIMATES, to be replaced with measured values. See MEASUREMENTS.md. -->
  <xacro:property name="wheel_radius"     value="0.0325"/> <!-- [PENDING] -->
  <xacro:property name="wheel_width"      value="0.026"/>  <!-- [PENDING] -->
  <xacro:property name="wheel_separation" value="0.180"/>  <!-- [PENDING] -->
  <xacro:property name="caster_offset_x"  value="-0.070"/> <!-- [PENDING] -->

  <!-- [PENDING] additional estimates not in the datasheet, needed to complete the model but
       not called out explicitly in the brief's property list. See MEASUREMENTS.md. -->
  <xacro:property name="caster_radius" value="0.012"/> <!-- [PENDING]: caster wheel/ball radius -->
  <xacro:property name="chassis_ground_clearance" value="0.005"/> <!-- [PENDING]: gap between
       chassis underside and the wheel-ground contact plane -->

  <!-- Mass split across links. total_mass is CONFIRMED (1.0 kg); this split is a reasonable
       engineering assumption pending a per-link measurement (MEASUREMENTS.md) - the wheels
       and caster are metal-geared/small and a modest fraction of the total is a safe
       approximation for inertia purposes on a robot this size. -->
  <xacro:property name="wheel_mass"  value="0.05"/>  <!-- [PENDING], each wheel -->
  <!-- caster_mass revised up from an initial 0.02 kg (docs/phase2-findings.md): that value
       treated the caster as just the bare ball, but a real caster is an assembly (bracket +
       swivel + ball), and more importantly, with chassis mass distributed as a symmetric box
       centered directly over the drive-wheel axle, the system COM sits almost exactly at the
       wheel axle (torque-balance math: COM offset from the axle is caster_mass*caster_offset_x
       / total_mass) - at 0.02 kg the caster carried only ~2% of the robot's static weight, a
       stability margin so thin that ordinary accel/decel transients during driving (braking
       after forward motion, reversing turn direction) could momentarily unweight it enough to
       tip the chassis, confirmed via ground-truth pose logging across many repro attempts.
       0.15 kg brings that to ~15% - still physically reasonable for a caster assembly on a 1 kg
       robot, and enough static margin that transient unweighting no longer fully lifts it. -->
  <xacro:property name="caster_mass" value="0.15"/>  <!-- [PENDING] -->
  <xacro:property name="chassis_mass" value="${total_mass - 2*wheel_mass - caster_mass}"/>

  <!-- Wheel axle height above the ground/base_footprint plane. Derived from wheel_radius
       (itself [PENDING]), not an independent measurement. -->
  <xacro:property name="axle_z" value="${wheel_radius}"/>
  <!-- Chassis box is centered above the axle by however much clearance sits below it. -->
  <xacro:property name="chassis_z" value="${axle_z + chassis_height/2.0 - chassis_ground_clearance}"/>

  <!-- LiDAR mount: centered on the chassis, on top, on a standoff. Standoff height is
       [PENDING] (depends on the actual mounting bracket). Default raised to 0.03 m (from an
       initial 0.005 m) after spawning in Gazebo showed the horizontal scan plane grazing the
       flat chassis top at near-tangent incidence, self-detecting it across a wide smoothly-
       varying angular arc (0.2 m near-perpendicular up to several metres at grazing angles) -
       confirmed empirically, not assumed. 0.03 m gives genuine clearance over the 0.19 m
       chassis top; real LiDAR mounts on small robots need this kind of clearance for the
       same reason. -->
  <xacro:property name="lidar_standoff" value="0.03"/> <!-- [PENDING], see comment above -->
  <!-- Empirical note (2026-07-22): a ~176deg self-detection artifact was investigated at
       length here (standoff 0.005/0.03/0.08 all tested) and root-caused to the gpu_lidar
       sensor's own rear-hemisphere rendering, NOT robot geometry - rotating the sensor's yaw
       180deg moved the artifact with it (sensor-frame-relative, not world-frame-relative),
       and no amount of standoff height changed that. Confirmed as a gz-sim 6.18.0 (Fortress)
       rendering limitation, not a modeling error - see docs/phase1-findings.md for the full
       diagnostic trail and upstream issue search. A CPU "lidar" sensor type was tried as an
       alternative and found completely non-functional on this install (no gz-transport topic
       at all). Settled back on a modest, physically-defensible 0.03 m standoff (raising it
       further doesn't help, since the cause isn't clearance). -->

  <!-- DECISION (2026-07-22, masking chosen over a downstream filter node - see
       docs/phase1-findings.md for the reasoning: masking at the source means there is only
       ever one /scan topic, avoiding the failure mode where one consumer reads the filtered
       topic and another reads the raw one): masked to the front ~180deg, safely inside the
       measured ~184deg clean arc (2 deg margin either side). This makes the sensor
       deliberately pessimistic in field of view on top of the already-deliberate 8 m range
       cap (S3 of the brief) - closer to a real budget 180deg LiDAR than the original 360deg
       spec, and that combination should be stated as a known limitation, not an accident.
       samples scales with the FOV to hold the ~1 deg angular resolution spec (S3) constant.
       Restore lidar_horizontal_fov to ${2*pi} (and samples to 360) in one place here if a
       gz-sim version without this rendering bug is ever confirmed. -->
  <xacro:property name="lidar_horizontal_fov" value="${pi}"/>
  <xacro:property name="lidar_samples" value="180"/>


  <material name="chassis_grey">
    <color rgba="0.6 0.6 0.6 1.0"/>
  </material>
  <material name="dark_grey">
    <color rgba="0.2 0.2 0.2 1.0"/>
  </material>

  <!-- ================= base_footprint / base_link ================= -->
  <!-- Nav2 convention: base_footprint is the ground-projected reference frame; base_link is
       the physical chassis frame, offset up to axle height. -->
  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${axle_z}" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 ${chassis_z - axle_z}" rpy="0 0 0"/>
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>
      <material name="chassis_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${chassis_z - axle_z}" rpy="0 0 0"/>
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 ${chassis_z - axle_z}" rpy="0 0 0"/>
      <mass value="${chassis_mass}"/>
      <!-- Computed from mass + geometry (box inertia), not a magic number. -->
      <inertia
        ixx="${chassis_mass/12.0*(chassis_width*chassis_width + chassis_height*chassis_height)}" ixy="0" ixz="0"
        iyy="${chassis_mass/12.0*(chassis_length*chassis_length + chassis_height*chassis_height)}" iyz="0"
        izz="${chassis_mass/12.0*(chassis_length*chassis_length + chassis_width*chassis_width)}"/>
    </inertial>
  </link>

  <!-- ================= Wheels ================= -->
  <xacro:macro name="wheel" params="prefix reflect">
    <link name="${prefix}_wheel">
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2.0} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="dark_grey"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2.0} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="${wheel_mass}"/>
        <!-- Solid-cylinder inertia, axis along the wheel's rotation axis (Y after the 90 deg
             visual/collision rotation above), computed from mass + geometry. -->
        <inertia
          ixx="${wheel_mass/12.0*(3*wheel_radius*wheel_radius + wheel_width*wheel_width)}" ixy="0" ixz="0"
          iyy="${wheel_mass/2.0*wheel_radius*wheel_radius}" iyz="0"
          izz="${wheel_mass/12.0*(3*wheel_radius*wheel_radius + wheel_width*wheel_width)}"/>
      </inertial>
    </link>

    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${prefix}_wheel"/>
      <!-- base_link's own origin (via base_footprint_joint) is already placed at axle_z above
           the ground, so the wheel joint needs NO further z-offset - it sits at z=0 relative to
           base_link. A previous version used "${axle_z - chassis_z}" here (-0.03 m), which
           re-offset the wheel relative to the CHASSIS's center height instead of relative to
           base_link's own (already-correct) origin. That silently buried the wheels 3 cm below
           the ground plane at spawn (while the caster, computed off the same wrong baseline,
           ended up floating ~1 cm above it) - the physics engine's contact resolution reacted
           to that invalid interpenetration with a large corrective torque, tipping the chassis
           to a stable ~33 deg equilibrium within about two minutes of sim time, with the wheels
           still spinning throughout (encoder-driven odometry kept accumulating "distance" the
           whole time). That is what actually produced the "ghost obstacle" SLAM map corruption
           and the huge odom-vs-ground-truth divergence chased across the v1-v4 driving-script
           iterations (docs/phase2-findings.md) - none of those were the real bug. Confirmed via
           a ground-truth pose monitor showing pitch grow steadily from spawn with ZERO drive
           commands ever sent, ruling out anything in the driving scripts. -->
      <origin xyz="0 ${reflect * wheel_separation/2.0} 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <!-- Joint damping: a real motor/gearbox has internal damping a rigid-body sim doesn't
           model by default. Without it, ANY sudden commanded-velocity reversal (braking after
           forward motion, reversing turn direction, turning right after forward motion) applies
           a near-instant torque change to a wheel, which - combined with the caster's very thin
           static load margin, see the caster friction comment below - was enough to tip the
           chassis. diff_drive_controller.yaml's acceleration limits address the SAME root cause
           from the command side (see its comment) but only for the specific transition each
           limit targets; this is the general, structural version of the same fix. -->
      <dynamics damping="0.05" friction="0.0"/>
    </joint>
  </xacro:macro>

  <xacro:wheel prefix="left" reflect="1"/>
  <xacro:wheel prefix="right" reflect="-1"/>

  <!-- ================= Caster (simple sphere, standard simplification) ================= -->
  <link name="caster_wheel">
    <visual>
      <geometry>
        <sphere radius="${caster_radius}"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <geometry>
        <sphere radius="${caster_radius}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="${caster_mass}"/>
      <inertia
        ixx="${2.0/5.0*caster_mass*caster_radius*caster_radius}" ixy="0" ixz="0"
        iyy="${2.0/5.0*caster_mass*caster_radius*caster_radius}" iyz="0"
        izz="${2.0/5.0*caster_mass*caster_radius*caster_radius}"/>
    </inertial>
  </link>

  <joint name="caster_wheel_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_wheel"/>
    <!-- Caster sphere's bottom should touch the ground plane, same as the wheels: center at
         caster_radius above ground, i.e. (caster_radius - axle_z) relative to base_link's
         origin (which sits at axle_z above ground). See the wheel joint comment above for the
         wrong-baseline bug this replaces. -->
    <origin xyz="${caster_offset_x} 0 ${caster_radius - axle_z}" rpy="0 0 0"/>
  </joint>

  <!-- ================= LiDAR ================= -->
  <xacro:crowd_nav_lidar
    parent_link="base_link"
    xyz="0 0 ${chassis_z - axle_z + chassis_height/2.0 + lidar_standoff}"
    rpy="0 0 0"
    horizontal_fov="${lidar_horizontal_fov}"
    samples="${lidar_samples}"/>

  <!-- ================= ros2_control hardware interface (swap point) ================= -->
  <xacro:nvis_3302ard_ros2_control/>

  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find crowd_nav_control)/config/diff_drive_controller.yaml</parameters>
    </plugin>
  </gazebo>

  <gazebo reference="base_link">
    <material>Gazebo/Grey</material>
  </gazebo>

  <!-- Caster friction: no friction coefficient was specified anywhere for this model, so the
       physics engine's default (high enough to resist sliding) applied to the caster sphere too.
       During any pure in-place rotation (ang!=0, lin=0 - used constantly by the SLAM coverage
       sweep scripts, docs/phase2-findings.md), the two drive wheels spin in place while the
       caster, offset behind the axle, needs to scrub/slide sideways to let the chassis pivot. A
       high-friction caster can't do that smoothly - it catches, and the resulting torque tips
       the chassis up on one side while yaw keeps climbing unbounded and x/y freezes. Confirmed
       empirically: ground-truth pose logging showed exactly this signature (frozen position,
       runaway yaw, pitch jumping to ~17 deg) starting mid-way through the very first in-place
       turn segment of a sweep, on a model where the earlier wheel/caster z-offset bug (see the
       wheel joint comment above) had already been fixed and ruled out. Near-zero friction here
       lets the caster pivot freely, as it physically would (it's a small low-friction ball
       caster on the real hardware, not a driven/gripping wheel). -->
  <gazebo reference="caster_wheel">
    <mu1>0.001</mu1>
    <mu2>0.001</mu2>
  </gazebo>

  <!-- Drive wheel friction: previously left unspecified (engine default), same as the ground
       plane's own unspecified <ode/> friction block. Set explicitly to a normal, grippy value -
       traction is what lets the wheels roll instead of skid, including during the sudden
       rolling-to-differential transition when a forward move is immediately followed by an
       in-place turn. -->
  <gazebo reference="left_wheel">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>
  <gazebo reference="right_wheel">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>

</robot>
