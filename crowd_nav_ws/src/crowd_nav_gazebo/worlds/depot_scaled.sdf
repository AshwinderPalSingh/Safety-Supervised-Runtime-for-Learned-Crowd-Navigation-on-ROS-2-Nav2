<?xml version="1.0" ?>
<sdf version="1.7">
  <world name="crowd_nav_depot_scaled">
    <physics name="10ms" type="ignored">
      <!-- Renamed from "1ms" (its value was always 10ms - a stale/misleading label, not a
           step-size bug: tried tightening to 0.001 while chasing a tip-over bug during Phase 2
           (docs/phase2-findings.md) and confirmed it made no difference to that issue, which
           turned out to be a caster mass/friction problem, not a solver-precision one. Reverted
           to 0.01 to avoid the ~3x CPU cost for no benefit; just fixed the name to match. -->
      <max_step_size>0.01</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="libignition-gazebo-physics-system.so" name="ignition::gazebo::systems::Physics"/>
    <plugin filename="libignition-gazebo-user-commands-system.so" name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="libignition-gazebo-scene-broadcaster-system.so" name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-sensors-system" name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- Visual-only, zero physics/collision impact: no <scene> block existed before, so
         everything rendered under ogre2's bare default ambient/background (the flat, washed-out
         "grey primitives floating in a void" look). Raising ambient and giving the sky a
         deliberate industrial-interior tone fixes that without touching a single collision
         shape or evaluation-relevant coordinate. -->
    <scene>
      <ambient>0.40 0.40 0.42 1</ambient>
      <background>0.55 0.60 0.65 1</background>
      <shadows>true</shadows>
      <grid>false</grid>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.85 0.82 0.78 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation><range>1000</range><constant>0.9</constant><linear>0.01</linear><quadratic>0.001</quadratic></attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Three warm, non-shadow-casting point lights standing in for ceiling fixtures along the
         room's long axis - fill light only (the sun above is still the sole shadow-casting
         light, so this doesn't multiply shadow-render cost), purely to break up the single-flat-
         directional-light look that read as a CAD viewport rather than an indoor space. -->
    <light type="point" name="ceiling_light_1">
      <pose>-2.5 0 2.3 0 0 0</pose>
      <diffuse>1.0 0.95 0.85 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <attenuation><range>8</range><constant>0.3</constant><linear>0.2</linear><quadratic>0.05</quadratic></attenuation>
      <cast_shadows>false</cast_shadows>
    </light>
    <light type="point" name="ceiling_light_2">
      <pose>0.5 0 2.3 0 0 0</pose>
      <diffuse>1.0 0.95 0.85 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <attenuation><range>8</range><constant>0.3</constant><linear>0.2</linear><quadratic>0.05</quadratic></attenuation>
      <cast_shadows>false</cast_shadows>
    </light>
    <light type="point" name="ceiling_light_3">
      <pose>3.2 0 2.3 0 0 0</pose>
      <diffuse>1.0 0.95 0.85 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <attenuation><range>8</range><constant>0.3</constant><linear>0.2</linear><quadratic>0.05</quadratic></attenuation>
      <cast_shadows>false</cast_shadows>
    </light>

